subscription_id = "00000000-0000-0000-0000-000000000000"
tenant_id       = "00000000-0000-0000-0000-000000000000"

name_prefix             = "contoso"
environment             = "platform"
location                = "eastus2"
management_group_prefix = "contoso"

deploy_management_groups = true

# Keys are subscription IDs. Values are management-group keys documented in variables.tf.
subscription_placements = {
  # "11111111-1111-1111-1111-111111111111" = "connectivity"
  # "22222222-2222-2222-2222-222222222222" = "management"
  # "33333333-3333-3333-3333-333333333333" = "corp"
}

deploy_subscription_policy = true
allowed_locations           = ["eastus2", "centralus"]

hub_address_space               = ["10.10.0.0/16"]
spoke_address_space             = ["10.20.0.0/16"]
firewall_subnet_prefix          = "10.10.0.0/26"
bastion_subnet_prefix           = "10.10.0.64/26"
dns_inbound_subnet_prefix       = "10.10.0.128/28"
dns_outbound_subnet_prefix      = "10.10.0.144/28"
private_endpoint_subnet_prefix  = "10.10.0.160/27"
workload_subnet_prefix          = "10.20.1.0/24"

enable_firewall             = true
enable_bastion              = true
enable_dns_private_resolver = true
enable_key_vault            = true

# Paid plans must be approved by the security and cost owners before use.
defender_plans = [
  # "VirtualMachines",
  # "StorageAccounts",
  # "KeyVaults"
]

# Replace these examples with approved DNS servers. Leave empty when hybrid DNS is not required.
dns_forwarding_rules = {
  # corp_example = {
  #   domain_name = "corp.example.com."
  #   target_ips  = ["10.50.0.4", "10.50.0.5"]
  # }
}

enable_activity_log_diagnostics = true
log_retention_days              = 90
monthly_budget_amount           = 500
budget_contact_emails           = []

tags = {
  owner       = "cloud-platform"
  cost_center = "shared-services"
}
